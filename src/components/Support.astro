---
const sponsorsUrl = 'https://github.com/sponsors/kardasz';
---

<section class="pb-20 px-4" aria-labelledby="support-title">
  <div class="max-w-3xl mx-auto">
    <div class="flex flex-wrap items-center gap-4 sm:gap-5 rounded-2xl border border-border dark:border-dark-border bg-surface-alt dark:bg-dark-surface-alt p-5 sm:p-6">
      <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-accent-light dark:bg-dark-accent-light flex items-center justify-center text-accent dark:text-dark-accent">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <div class="flex-1 min-w-[16rem] text-left">
        <span class="text-xs font-medium uppercase tracking-wide text-text-muted dark:text-dark-text-muted">Free &amp; open source</span>
        <h2 id="support-title" class="text-base font-semibold text-text-primary dark:text-dark-text-primary mt-0.5 mb-1">
          Does this help you prepare?
        </h2>
        <p class="text-sm text-text-secondary dark:text-dark-text-secondary">
          Help keep SFCE Learning free, ad-free, and up to date with every Symfony release.
        </p>
      </div>

      <a
        href={sponsorsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-2.5 rounded-lg bg-accent hover:bg-accent-hover text-white text-sm font-medium transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Sponsor on GitHub
      </a>
    </div>
  </div>
</section>
